# DOCUMENTATION: https://docs.mashdiv.com
# SUPPORT: https://support.mashdiv.com

# --------------- App ---------------

NEXT_PUBLIC_SITE_URL="http://localhost"
NEXT_PUBLIC_SITE_NAME="BIDEX"
NEXT_PUBLIC_SITE_DESCRIPTION="BIDEX is a cryptocurrency exchange platform, where you can trade Bitcoin, Ethereum, Litecoin, and other cryptocurrencies."
NEXT_PUBLIC_DEMO_STATUS="false"
NODE_ENV="production"
NEXT_PUBLIC_FRONTEND_PORT="3000"
NEXT_PUBLIC_BACKEND_PORT="4000"
NEXT_PUBLIC_BACKEND_THREADS="2"
NEXT_PUBLIC_DEFAULT_LANGUAGE="en"
NEXT_PUBLIC_LANGUAGES="en,es,fr,de,it,pt,ru,ar,ja,ko,hi,tr"
NEXT_PUBLIC_DEFAULT_THEME="dark" # dark, light, system
NEXT_PUBLIC_FRONTEND="true" # true, false

# Development only: Additional allowed IPs for dev server (comma-separated)
# These are used for accessing the dev server from local network devices
# Example: "192.168.0.251,172.28.112.1,172.23.144.1"
NEXT_PUBLIC_ALLOWED_DEV_IPS=""

# --------------- Database ---------------

DB_NAME="v4"
DB_USER="root"
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT="3306"

# ScyllaDB (Used for Ecosystem trading: candles, orderbooks, trades, and orders)
SCYLLA_CONNECT_POINTS="127.0.0.1:9042"
SCYLLA_DATACENTER="datacenter1"
SCYLLA_USERNAME=""
SCYLLA_PASSWORD=""
SCYLLA_KEYSPACE="trading"
SCYLLA_FUTURES_KEYSPACE="futures"

# --------------- Config ---------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="UA-123456789-1"
NEXT_PUBLIC_FACEBOOK_PIXEL_ID="123456789"

# --------------- Security ---------------

# TOKEN SECRETS (Please change them every 2 - 4 weeks)
# Can create in node 'crypto.randomBytes(64).toString('hex')'
# Or you can use https://www.browserling.com/tools/random-hex (128 digits)
APP_ACCESS_TOKEN_SECRET="53a9d9e298e906972060f7c159cf9f542beca86db5a26ebd333d6360b7ab34d5529bad5bd02034e0d6ab5ad2f7ea6fac54f6cb142e4d31dc26deeb0e0559e68a"
APP_REFRESH_TOKEN_SECRET="368775e6584f35b1d4159a2bcfdc7304724186e7f2609354ab4a7a511120e0aee1cb923b3266b32b8748388f942fe13f1478c15b7369be3af124959ccc86087e"
APP_RESET_TOKEN_SECRET="5f16143fb4c7fcc18e7c7508630074f3dc6a7cb0d52bfa54c2434e391a1039c10ae0149c02d51858ae07772fe31e99df566b52d1efb44282b406d9293b5c61ff"
APP_VERIFY_TOKEN_SECRET="28e6287b695ec54517ebca62d00742a70c17df1acd46f4ddb368138190d095c364ecbeb99b62e1b9edc2dd99237bff8791fefca1ac552b6fe9986ee776cf4055"
JWT_EXPIRY="30m"
JWT_REFRESH_EXPIRY="14d"
JWT_RESET_EXPIRY="1h"

# --------------- Rate Limit ---------------
# Global per-IP ceiling on POST/PUT/PATCH/DELETE, applied by the framework
# middleware. It is keyed by IP, NOT by user, so every trader behind one NAT or
# proxy shares a single bucket — 100/min was low enough that ordinary trading on
# the terminal tripped it and surfaced "Rate Limit Exceeded, Try Again Later".
# Login and the other sensitive routes keep their own stricter limiters on top.
RATE_LIMIT="3000" # 3000 mutating requests per minute, per IP
# NOTE: the middleware reads RATE_LIMIT_EXPIRE (no Y). RATE_LIMIT_EXPIRY was never
# read by anything and is kept only so an old deployment does not look changed.
RATE_LIMIT_EXPIRE="60" # 60 seconds
RATE_LIMIT_EXPIRY="60" # unused — see above


# If using a browser like your Nuxt app, use 'browser' for production
# If using a browser like your Nuxt app, use 'browser-dev' for development
# If you're not using a browser, then use 'app'
APP_CLIENT_PLATFORM="browser"

# --------------- Providers ---------------

# Stripe API
APP_STRIPE_PUBLIC_KEY="pk_xxxxxxxxxxxxxxxxxxxxxx"
APP_STRIPE_SECRET_KEY="sk_xxxxxxxxxxxxxxxxxxxxxx"

# PayPal API
NEXT_PUBLIC_APP_PAYPAL_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxx"
APP_PAYPAL_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxx"

# PayStack API
APP_PAYSTACK_SECRET_KEY=
APP_PAYSTACK_PUBLIC_KEY=

OANDA_API_KEY=your_oanda_api_key

# --------------- Mail ---------------

# nodemailer-service, nodemailer-smtp, nodemailer-sendgrid, local
APP_EMAILER="nodemailer-smtp"
NEXT_PUBLIC_APP_EMAIL="text@gmail.com"
APP_EMAIL_SENDER_NAME="Your Company Name"

# nodemailer-service (For Gmail or Outlook) use app password not your real password
APP_NODEMAILER_SERVICE="gmail"
APP_NODEMAILER_SERVICE_SENDER="xxxxxxxxxxxxxxxxxxxxxx@gmail.com"
APP_NODEMAILER_SERVICE_PASSWORD="xxxxxxxxxxxxxxxxxxxxxx"

# nodemailer-smtp
APP_NODEMAILER_SMTP_HOST="mail.xxxxxxxxxxxxxxxxxxxxxx.com"
APP_NODEMAILER_SMTP_PORT="587"
APP_NODEMAILER_SMTP_ENCRYPTION="tls"  # Use "tls" for port 587 (STARTTLS), "ssl" for port 465 (SSL/TLS)
APP_NODEMAILER_SMTP_SENDER="support@xxxxxxxxxxxxxxxxxxxxxx.com"
APP_NODEMAILER_SMTP_PASSWORD="xxxxxxxxxxxxxxxxxxxxxx"

# SENDGRID API KEY (For Sendgrid Emailer)
APP_SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxx"
APP_SENDGRID_SENDER="bounces+xxxxxxxxxxxxxxxxxxxxxx.com"

# SENDMAIL PATH (For Local Emailer, use 'which sendmail' to find the path, if not found, install sendmail)
APP_SENDMAIL_PATH="/usr/sbin/sendmail"

# --------------- Auth ---------------

# Twilio API (Used for Auth OTP and SMS Notifications)
APP_TWILIO_ACCOUNT_SID="xxxxxxxxxxxxxxxxxxxxxx"
APP_TWILIO_VERIFY_SERVICE_SID="xxxxxxxxxxxxxxxxxxxxxx"
APP_TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxx"
APP_TWILIO_PHONE_NUMBER="+9xxxxxxxxxxxxxxxxxxxxxx"
APP_TWILIO_MESSAGING_SERVICE_SID=""
APP_SUPPORT_PHONE_NUMBER="+9xxxxxxxxxxxxxxxxxxxxxx"

# --------------- Notifications ---------------

# Redis (for notification queue and caching)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Firebase Cloud Messaging (FCM) for Mobile Push Notifications (iOS/Android)
# Required for native mobile apps - get credentials from Firebase Console
FCM_PROJECT_ID="your-project-id"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key\n-----END PRIVATE KEY-----"
FCM_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FCM_SERVICE_ACCOUNT_PATH=""

# Web Push (VAPID) for Browser Push Notifications
# Works without Firebase - for Chrome, Firefox, Edge, Safari
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"


# --------------- Exchanges ---------------

# Exchange first 3 letters of the alias (kucoin, binance, kraken, okx, xt)
NEXT_PUBLIC_EXCHANGE="bin"

# KuCoin API (alias: kucoin)
APP_KUCOIN_API_KEY="xxxxxxxxxxxxxxxxxxxxxx"
APP_KUCOIN_API_SECRET="xxxxxxxxxxxxxxxxxxxxxx"
APP_KUCOIN_API_PASSPHRASE="xxxxxxxxxxxxxxxxxxxxxx"

# Binance API (alias: binance)
APP_BINANCE_API_KEY="xxxxxxxxxxxxxxxxxxxxxx"
APP_BINANCE_API_SECRET="xxxxxxxxxxxxxxxxxxxxxx"

# XT API (alias: xt)
APP_XT_API_KEY="xxxxxxxxxxxxxxxxxxxxxx"
APP_XT_API_SECRET="xxxxxxxxxxxxxxxxxxxxxx"

# --------------- AI ---------------

# OpenAI
OPENAI_API_KEY="xxxxxxxxxxxxxxxxxxxx"
DEEPSEEK_API_KEY="xxxxxxxxxxxxxxxxxxxx"
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxx"

# --------------- OBSERVABILITY ---------------

# Sentry error tracking (optional). Leave SENTRY_DSN empty to disable — the app
# then degrades to structured error logging with no extra dependency. To enable:
#   pnpm --filter backend add @sentry/node   then set SENTRY_DSN below.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"

# OTC price freshness: if the cached price is older than this (ms), the entry
# path fetches a fresh price and, if the feed is unreachable, HALTS the order
# instead of trading on frozen data. Set OTC_ALLOW_STALE_ENTRY=true to override
# (not recommended for live money).
OTC_PRICE_MAX_STALE_MS="15000"
OTC_ALLOW_STALE_ENTRY="false"

# --------------- FIAT ---------------

# Fiat Rates Provider (openexchangerates, exchangerate-api)
APP_FIAT_RATES_PROVIDER="openexchangerates"

# OpenExchangeRates API
APP_OPENEXCHANGERATES_APP_ID="xxxxxxxxxxxxxxxxxxxx"

# ExchangeRate API
APP_EXCHANGERATE_API_KEY="xxxxxxxxxxxxxxxxxxxx"
# Rupee deposit rails. A method whose variables are unset is shown as
# unavailable rather than hidden, so nobody wonders where UPI went.
# Partial bank details are treated as unset: a transfer missing the IFSC is a
# payment that bounces or lands somewhere unrecoverable.
DEPOSIT_UPI_ID=""
DEPOSIT_UPI_NAME=""
DEPOSIT_BANK_NAME=""
DEPOSIT_BANK_ACCOUNT=""
DEPOSIT_BANK_IFSC=""
DEPOSIT_BANK_BANKNAME=""

# Deposit bonuses.  code:percent:minDeposit:maxBonus  (comma separated)
# minDeposit and maxBonus are in USDT; maxBonus 0 means uncapped.
# Unset means the bonus field is hidden entirely rather than offered with
# nothing behind it.
DEPOSIT_BONUS_CODES=""

# NOWPayments — the deposit processor. Issues an address per payment, which is
# what removes the need for a transaction hash.
# IPN_SECRET is what makes the callback trustworthy; without it every callback
# is rejected, which is the correct failure but means no deposit ever credits.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_IPN_URL="https://terminal.web-bytes.in/api/finance/deposit/ipn"
